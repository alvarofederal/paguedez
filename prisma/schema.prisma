// prisma/schema.prisma — Pague Dez

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Papel {
  ADMIN
  USUARIO
}

enum Sexo {
  MASCULINO
  FEMININO
}

enum TipoTaca {
  PRIMEIRA // primeira flexão registrada — taça "Recruta"
  DIARIO
  SEMANAL
  MENSAL
  ANUAL
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  sexo     Sexo
  papel    Papel   @default(USUARIO)
  ativo    Boolean @default(true)

  registros Registro[]
  tacas     Taca[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("users")
}

// Uma série de flexões ("flecas") registrada pelo botão PAGUEI!
model Registro {
  id         String   @id @default(cuid())
  userId     String
  quantidade Int
  dia        String   @db.VarChar(10) // "YYYY-MM-DD" no horário de Brasília
  feitoEm    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dia])
  @@map("registros")
}

// Uma taça por (usuário, tipo, período). Se o recorde for ampliado no mesmo período,
// o valor da taça é atualizado em vez de criar outra.
model Taca {
  id            String   @id @default(cuid())
  userId        String
  tipo          TipoTaca
  periodo       String   @db.VarChar(10) // "2026-10-06", "2026-W41", "2026-10" ou "2026"
  valor         Int
  nivel         Int // nº sequencial da conquista — define tamanho e categoria da taça
  conquistadaEm DateTime @default(now())
  atualizadaEm  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tipo, periodo])
  @@index([userId])
  @@map("tacas")
}
