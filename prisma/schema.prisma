// prisma/schema.prisma — Pague Dez

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Papel {
  ADMIN
  USUARIO
}

enum Sexo {
  MASCULINO
  FEMININO
}

enum TipoTaca {
  PRIMEIRA // primeira flexão registrada — taça "Recruta"
  DIARIO
  SEMANAL
  MENSAL
  ANUAL
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  sexo     Sexo
  papel    Papel   @default(USUARIO)
  ativo    Boolean @default(true)

  registros Registro[]
  tacas     Taca[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("users")
}

// Uma série de flexões ("flecas") registrada pelo botão PAGUEI!
model Registro {
  id         String   @id @default(cuid())
  userId     String
  quantidade Int
  dia        String   @db.VarChar(10) // "YYYY-MM-DD" no horário de Brasília
  feitoEm    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dia])
  @@map("registros")
}

// Uma taça por (usuário, tipo, período). Se o recorde for ampliado no mesmo período,
// o valor da taça é atualizado em vez de criar outra.
model Taca {
  id            String   @id @default(cuid())
  userId        String
  tipo          TipoTaca
  periodo       String   @db.VarChar(10) // "2026-10-06", "2026-W41", "2026-10" ou "2026"
  valor         Int
  nivel         Int // nº sequencial da conquista — define tamanho e categoria da taça
  conquistadaEm DateTime @default(now())
  atualizadaEm  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tipo, periodo])
  @@index([userId])
  @@map("tacas")
}

// ─────────────────────────────────────────────────────────────
// SOCIAL — convites por WhatsApp, amizades, comunidades e emblemas
// Somente tabelas novas, sem relações declaradas: as tabelas users,
// registros e tacas não sofrem nenhuma alteração. Ver planning/convites-comunidade.md
// ─────────────────────────────────────────────────────────────

enum StatusConvite {
  PENDENTE
  ACEITO
  EXPIRADO
  CANCELADO
}

enum PapelComunidade {
  DONO
  MEMBRO
}

enum TipoEmblema {
  RECRUTA
  RECRUTADOR
  COMANDANTE
  PERSISTENTE
  CENTENARIO
}

// Convite de um usuário para um amigo (opcionalmente para uma comunidade).
// O link carrega um token aleatório; no banco só existe o SHA-256 dele.
// O telefone nunca é guardado por inteiro: HMAC (anti-duplicidade) + máscara (exibição).
model Convite {
  id              String        @id @default(cuid())
  convidanteId    String
  comunidadeId    String?
  apelido         String        @db.VarChar(40)
  telefoneHmac    String        @db.VarChar(64)
  telefoneMascara String        @db.VarChar(24)
  tokenHash       String        @unique @db.VarChar(64)
  status          StatusConvite @default(PENDENTE)
  criadoEm        DateTime      @default(now())
  expiraEm        DateTime
  abertoEm        DateTime?
  aceitoEm        DateTime?
  aceitoPorId     String?

  @@index([convidanteId, status])
  @@index([convidanteId, telefoneHmac])
  @@index([comunidadeId])
  @@map("convites")
}

// Amizade é por par (A < B pelo id). aMostra/bMostra = nível que cada lado mostra ao outro:
// 0 só ranking · 1 + recordes e taças · 2 + séries e gráfico.
model Amizade {
  id              String   @id @default(cuid())
  usuarioAId      String
  usuarioBId      String
  aMostra         Int      @default(0)
  bMostra         Int      @default(0)
  origemConviteId String?
  criadoEm        DateTime @default(now())

  @@unique([usuarioAId, usuarioBId])
  @@index([usuarioBId])
  @@map("amizades")
}

// O DONO escolhe o que os membros enxergam uns dos outros (nivelVisibilidade 0, 1 ou 2).
model Comunidade {
  id                String   @id @default(cuid())
  donoId            String
  nome              String   @db.VarChar(40)
  descricao         String?  @db.VarChar(140)
  cor               String   @db.VarChar(16)
  nivelVisibilidade Int      @default(0)
  codigoEntrada     String   @unique @db.VarChar(16)
  entradaAtiva      Boolean  @default(true)
  criadoEm          DateTime @default(now())

  @@index([donoId])
  @@map("comunidades")
}

model MembroComunidade {
  comunidadeId String
  userId       String
  papel        PapelComunidade @default(MEMBRO)
  entrouEm     DateTime        @default(now())

  @@id([comunidadeId, userId])
  @@index([userId])
  @@map("membros_comunidade")
}

model Emblema {
  userId        String
  tipo          TipoEmblema
  conquistadoEm DateTime    @default(now())

  @@id([userId, tipo])
  @@map("emblemas")
}

// Convocação: alguém do pelotão chama um AMIGO que já está no app. O amigo precisa aceitar
// (consentimento: entrar num pelotão significa mostrar dados no nível que o comandante definiu).
enum StatusConvocacao {
  PENDENTE
  ACEITA
  RECUSADA
}

model Convocacao {
  id           String           @id @default(cuid())
  comunidadeId String
  convidadoId  String
  convidanteId String
  status       StatusConvocacao @default(PENDENTE)
  criadoEm     DateTime         @default(now())
  respondidoEm DateTime?

  @@unique([comunidadeId, convidadoId])
  @@index([convidadoId, status])
  @@map("convocacoes")
}

// Patentes militares (Recruta → Comandante). Guardamos cada patente conquistada: a patente nunca desce,
// mesmo que depois o usuário desfaça uma série ou um recruta saia. A atual é a mais alta.
enum PatenteMilitar {
  RECRUTA
  SOLDADO
  CABO
  SARGENTO
  TENENTE
  CAPITAO
  MAJOR
  CORONEL
  GENERAL
  COMANDANTE
}

model PatenteConquistada {
  userId        String
  patente       PatenteMilitar
  conquistadoEm DateTime       @default(now())

  @@id([userId, patente])
  @@map("patentes_conquistadas")
}

// ─────────────────────────────────────────────────────────────
// LEMBRETES — push notification para avisar a hora das flecas
// ─────────────────────────────────────────────────────────────

// Um aparelho/navegador que aceitou receber notificações (Web Push, padrão aberto: sem Firebase e sem custo).
model PushInscricao {
  id            String    @id @default(cuid())
  userId        String
  endpointHash  String    @unique @db.VarChar(64) // SHA-256 do endpoint (índice único em coluna TEXT não é possível)
  endpoint      String    @db.Text
  p256dh        String    @db.VarChar(255)
  auth          String    @db.VarChar(255)
  agente        String?   @db.VarChar(160)
  criadoEm      DateTime  @default(now())
  ultimoTesteEm DateTime?

  @@index([userId])
  @@map("push_inscricoes")
}

// Item da agenda do usuário: "todo dia às 19:00, se eu ainda não paguei".
// diasSemana é uma máscara de bits: bit 0 = segunda ... bit 6 = domingo (127 = todos os dias).
model Lembrete {
  id                String   @id @default(cuid())
  userId            String
  hora              String   @db.VarChar(5) // "HH:MM", horário de Brasília
  diasSemana        Int      @default(127)
  somenteSePendente Boolean  @default(true)
  ativo             Boolean  @default(true)
  criadoEm          DateTime @default(now())

  @@index([userId])
  @@index([ativo])
  @@map("lembretes")
}

enum StatusEnvioLembrete {
  PROCESSANDO
  ENVIADO
  IGNORADO_JA_PAGOU
  SEM_INSCRICAO
  FALHOU
}

// Um registro por (lembrete, dia): garante que o mesmo lembrete nunca dispara duas vezes no mesmo dia,
// mesmo que duas execuções do agendador se sobreponham (a chave única faz de "trava").
model LembreteEnvio {
  id         String              @id @default(cuid())
  lembreteId String
  dia        String              @db.VarChar(10)
  status     StatusEnvioLembrete @default(PROCESSANDO)
  detalhe    String?             @db.VarChar(200)
  criadoEm   DateTime            @default(now())

  @@unique([lembreteId, dia])
  @@map("lembrete_envios")
}
